<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="editTemplateDialog"
        title="Edit Template Details"
        contentWidth="400px"
        draggable="true"
    >
        <content>
            <VBox class="sapUiMediumMargin">
                <VBox class="sapUiSmallMarginBottom">
                    <Label text="Template Name" required="true" />
                    <Input
                        id="editTemplateNameInput"
                        value="{templateName}"
                        placeholder="Enter template name"
                    />
                </VBox>

                <VBox>
                    <Label text="Sheet Mode" />
                    <Select
                        id="editSheetModeSelect"
                        selectedKey="{sheetMode}"
                        width="100%"
                    >
                        <items>
                            <core:Item
                                key="SINGLE"
                                text="Single Sheet"
                            />
                            <core:Item
                                key="MULTIPLE"
                                text="Multiple Sheets"
                            />
                        </items>
                    </Select>
                </VBox>
            </VBox>
        </content>

        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveEdit"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCloseEditDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
