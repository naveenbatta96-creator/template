<mvc:View
    controllerName="com.template.builder.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m"
>
    <Page showHeader="true">
        <customHeader>
            <f:ShellBar
                title="Template Builder"
                showCopilot="false"
                showSearch="false"
                showNotifications="false"
                showProductSwitcher="false"
                homeIcon="https://www.sap.com/dam/application/shared/logos/sap-logo-svg.svg"
            />
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">
                <Table
                    id="templateTable"
                    class="sapUiMediumMarginTop"
                    items="{
                     path: '/templateMasterWithCount'
                    }"
                >
                    <headerToolbar>
                        <OverflowToolbar>
                            <ToolbarSpacer />
                            <Button
                                text="Create Template"
                                type="Emphasized"
                                icon="sap-icon://add"
                                press=".onCreateTemplate"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column>
                            <Text text="Template Id" />
                        </Column>
                        <Column>
                            <Text text="Template Name" />
                        </Column>
                        <Column>
                            <Text text="Template Type" />
                        </Column>
                        <Column>
                            <Text text="Sheet Mode" />
                        </Column>
                        <Column>
                            <Text text="Total Fields" />
                        </Column>
                        <Column >
                        <Text  text="Created" />
                        </Column>
                        <Column>
                            <Text text="Actions" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press=".onRowPress"
                        >
                            <cells>
                                <Text text="{
                                    parts: [
                                        {path: 'ID'},
                                        {path: 'templateType'}
                                    ],
                                    formatter: '.formatTemplateID'
                                }" />
                                <Text text="{templateName}" />
                                <Text text="{templateType}" />
                                <Text text="{sheetMode}" />

                                <Text text="{mappingsCount}" />
                                <Text text="{path: 'createdAt', formatter: '.formatDate'}" />
                                <HBox>
                                    <Button
                                        icon="sap-icon://download"
                                        type="Accept"
                                        tooltip="Download to Excel"
                                        press=".onDownloadExcel"
                                        class="sapUiTinyMarginEnd"
                                    />
                                    <Button
                                        text="Delete"
                                        type="Reject"
                                        press=".onDeleteTemplate"
                                    />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
