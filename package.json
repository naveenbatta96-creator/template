{
  "name": "lockbox-template-builder",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/postgres": "^2.3.0",
    "@sap/cds": "^9",
    "@sap/ux-ui5-tooling": "^1.25.0",
    "@sap/xssec": "^4",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "@ui5/cli": "^4.0.55",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5",
    "sqlite3": "^6.0.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --open lockbox.templatebuilder.templateui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "undeploy": "cf undeploy lockbox-template-builder --delete-services --delete-service-keys --delete-service-brokers"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/templateui"
  ],
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "sqlite.db"
          }
        },
        "[production]": {
          "kind": "postgres"
        }
      },
      "[production]": {
        "auth": "mocked"
      }
    }
  }
}